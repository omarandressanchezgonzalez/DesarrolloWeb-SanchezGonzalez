<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sanchez Gonzalez Omar Andres</title>
    <link rel="stylesheet" href="estilos.css">
</head>
<body>
    <div class="calculadora">
        <input type="text" id="pantalla" disabled>
        <div class="botones">
            <button>7</button>
            <button>8</button>
            <button>9</button>
            <button class="operador">+</button>
            <button>4</button>
            <button>5</button>
            <button>6</button>
            <button class="operador">-</button>
            <button>1</button>
            <button>2</button>
            <button>3</button>
            <button class="operador">*</button>
            <button>0</button>
            <button id="clear">C</button>
            <button id="igual">=</button>
            <button class="operador">/</button>
        </div>
    </div>
    <script src="calculadora.js"></script>
</body>
</html>
